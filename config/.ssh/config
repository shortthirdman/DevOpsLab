Host *
  Ciphers chacha20-poly1305@openssh.com,aes128-gcm@openssh.com
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 5m
  ServerAliveInterval 60
  ServerAliveCountMax 5
  Compression yes
  GSSAPIAuthentication no
  IdentityFile ~/.ssh/id_ed25519 # ssh-keygen -t ed25519 -C "your_email@example.com"
  TCPKeepAlive yes
  ForwardAgent yes
  IdentitiesOnly yes
  ClientAliveInterval 30
  ClientAliveCountMax 10

Host yourserver.tld
  HostName yourserver.tld
  ProxyJump user@proxy.server.tld